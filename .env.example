# Copy this file to .env and fill in real values.
# Any channel left blank runs in DRY-RUN mode (logs instead of sending).

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (SMTP) ---
# Works with Gmail SMTP, SendGrid's SMTP relay, or any org SMTP server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
